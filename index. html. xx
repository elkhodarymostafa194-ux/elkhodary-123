
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NOVA STORE</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #101010;
  color: white;
  font-family: Arial, sans-serif;
}

header {
  background: #191919;
  padding: 20px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
  border-bottom: 1px solid #333;
}

.logo {
  font-size: 23px;
  letter-spacing: 2px;
}

.logo span, .accent {
  color: #e63946;
}

nav {
  display: flex;
  gap: 18px;
}

nav a {
  color: #ddd;
  text-decoration: none;
}

.cart {
  background: #e63946;
  padding: 10px 15px;
  border-radius: 7px;
}

.hero {
  padding: 75px 20px;
  text-align: center;
  background: linear-gradient(135deg,#292929,#101010);
}

.hero h1 {
  font-size: 38px;
  margin-bottom: 15px;
}

.hero p {
  color: #bbb;
  line-height: 1.9;
  margin-bottom: 22px;
}

.btn {
  background: #e63946;
  color: white;
  border: none;
  padding: 13px 24px;
  border-radius: 7px;
  cursor: pointer;
}

.products {
  padding: 45px 6%;
}

.section-title {
  text-align: center;
  margin-bottom: 25px;
  font-size: 28px;
}

.search {
  display: block;
  width: 100%;
  max-width: 500px;
  margin: 0 auto 20px;
  padding: 14px;
  border-radius: 8px;
  border: 1px solid #444;
  background: #1d1d1d;
  color: white;
  outline: none;
}

.filters {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 30px;
}

.filter-btn {
  padding: 10px 17px;
  background: #252525;
  color: white;
  border: 1px solid #444;
  border-radius: 20px;
  cursor: pointer;
}

.filter-btn.active {
  background: #e63946;
  border-color: #e63946;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 20px;
}

.card {
  background: #1d1d1d;
  border: 1px solid #333;
  border-radius: 12px;
  overflow: hidden;
  text-align: center;
  padding-bottom: 20px;
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-5px);
  border-color: #e63946;
}

.card img {
  width: 100%;
  height: 190px;
  object-fit: cover;
  display: block;
}

.card h3 {
  margin: 17px 8px 10px;
}

.price {
  color: #e63946;
  font-size: 19px;
  font-weight: bold;
  margin-bottom: 15px;
}

.card button {
  background: #e63946;
  color: white;
  border: none;
  padding: 11px 22px;
  border-radius: 6px;
  cursor: pointer;
}

.card button:hover, .btn:hover {
  background: #b92130;
}

.empty {
  text-align: center;
  color: #aaa;
  grid-column: 1 / -1;
  padding: 30px;
}

.cart-section {
  background: #191919;
  margin: 10px 6% 40px;
  padding: 25px;
  border-radius: 12px;
  text-align: center;
  line-height: 2.2;
}

.about {
  text-align: center;
  padding: 45px 20px;
  color: #bbb;
  line-height: 2;
}

footer {
  text-align: center;
  padding: 25px;
  color: #888;
  background: #191919;
}

@media(max-width:650px) {
  header {
    justify-content: center;
  }

  nav {
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero h1 {
    font-size: 29px;
  }

  .product-grid {
    grid-template-columns: repeat(2,1fr);
    gap: 12px;
  }

  .card img {
    height: 135px;
  }

  .card h3 {
    font-size: 14px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">NOVA <span>STORE</span></div>

  <nav>
    <a href="#">الرئيسية</a>
    <a href="#products">المنتجات</a>
    <a href="#about">من نحن</a>
  </nav>

  <div class="cart">
    🛒 السلة: <span id="cart-count">0</span>
  </div>
</header>

<section class="hero">
  <h1>اكتشف عالم <span class="accent">NOVA</span></h1>
  <p>
    منتجات مميزة بتصميم عصري وأسعار تناسبك
    <br>
    اختار منتجك المفضل وابدأ التسوق
  </p>
  <button class="btn"
    onclick="document.getElementById('products').scrollIntoView()">
    تسوق الآن
  </button>
</section>

<section class="products" id="products">

  <h2 class="section-title">
    أحدث <span class="accent">المنتجات</span>
  </h2>

  <input
    class="search"
    id="search"
    type="search"
    placeholder="ابحث عن منتج..."
    oninput="renderProducts()"
  >

  <div class="filters">
    <button class="filter-btn active"
      onclick="setCategory('all',this)">الكل</button>

    <button class="filter-btn"
      onclick="setCategory('electronics',this)">إلكترونيات</button>

    <button class="filter-btn"
      onclick="setCategory('fashion',this)">موضة</button>

    <button class="filter-btn"
      onclick="setCategory('accessories',this)">إكسسوارات</button>
  </div>

  <div class="product-grid" id="product-grid"></div>

</section>

<section class="cart-section">
  <h2>سلة المشتريات 🛒</h2>
  <p>عدد المنتجات: <span id="cart-total">0</span></p>
  <p>الإجمالي: <span id="total-price">0</span> جنيه</p>
  <button class="btn" onclick="clearCart()">إفراغ السلة</button>
</section>

<section class="about" id="about">
  <h2>من نحن؟</h2>
  <p>نحن NOVA STORE، وجهتك للتسوق الإلكتروني.</p>
</section>

<footer>
  © 2026 NOVA STORE - جميع الحقوق محفوظة
</footer>

<script>
const products = [
  {
    id: 1,
    name: "سماعة لاسلكية",
    price: 350,
    category: "electronics",
    image: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600"
  },
  {
    id: 2,
    name: "ساعة ذكية",
    price: 500,
    category: "electronics",
    image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600"
  },
  {
    id: 3,
    name: "حقيبة عصرية",
    price: 400,
    category: "fashion",
    image: "https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=600"
  },
  {
    id: 4,
    name: "نظارة شمسية",
    price: 250,
    category: "accessories",
    image: "https://images.unsplash.com/photo-1511499767150-a48a237f0083?w=600"
  },
  {
    id: 5,
    name: "حذاء رياضي",
    price: 650,
    category: "fashion",
    image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600"
  },
  {
    id: 6,
    name: "كاميرا",
    price: 1200,
    category: "electronics",
    image: "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=600"
  }
];

let cart = [];
let selectedCategory = "all";

function renderProducts() {
  const grid = document.getElementById("product-grid");
  const search = document.getElementById("search")
    .value.trim().toLowerCase();

  const filtered = products.filter(product => {
    const matchesCategory =
      selectedCategory === "all" ||
      product.category === selectedCategory;

    const matchesSearch =
      product.name.toLowerCase().includes(search);

    return matchesCategory && matchesSearch;
  });

  if (filtered.length === 0) {
    grid.innerHTML = '<p class="empty">لا توجد منتجات مطابقة</p>';
    return;
  }

  grid.innerHTML = filtered.map(product => `
    <div class="card">
      <img
        src="${product.image}"
        alt="${product.name}"
        loading="lazy"
      >
      <h3>${product.name}</h3>
      <div class="price">${product.price} جنيه</div>
      <button onclick="addToCart(${product.id})">
        أضف للسلة
      </button>
    </div>
  `).join("");
}

function setCategory(category,button) {
  selectedCategory = category;

  document.querySelectorAll(".filter-btn")
    .forEach(btn => btn.classList.remove("active"));

  button.classList.add("active");
  renderProducts();
}

function addToCart(id) {
  const product = products.find(item => item.id === id);
  cart.push(product);
  updateCart();
}

function updateCart() {
  document.getElementById("cart-count").textContent = cart.length;
  document.getElementById("cart-total").textContent = cart.length;

  const total = cart.reduce((sum,item) => sum + item.price,0);

  document.getElementById("total-price").textContent = total;
}

function clearCart() {
  cart = [];
  updateCart();
}

renderProducts();
</script>

</body>
</html>
